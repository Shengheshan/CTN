# Fill these only for your own CTN environment. Never commit .env.
CTN_TEAM_CODE=
CTN_USERNAME=
CTN_PASSWORD=
CTN_TOKEN=

# The contextual model updates only when this is true and --policy bandit is used.
CTN_ENABLE_LEARNING=false
CTN_ENABLE_FEEDBACK=true
CTN_ENABLE_POLICY_ANALYTICS=true
CTN_OBSERVE_INTERVAL=60
